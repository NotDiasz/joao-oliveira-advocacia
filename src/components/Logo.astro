---
import mono from "../../brand/logo/monograma-verde-marfim.svg?raw";
import signature from "../../brand/logo/assinatura-verde-marfim.svg?raw";
import lockup from "../../brand/logo/lockup-verde-marfim.svg?raw";
interface Props {
  kind?: "mono" | "signature" | "lockup";
  class?: string;
  label?: string;
}
const { kind = "mono", class: className = "", label } = Astro.props;
const raw = { mono, signature, lockup }[kind]
  .replace(/fill="#[a-fA-F0-9]+"/g, 'fill="currentColor"')
  .replace(
    /role="img" aria-labelledby="title description"/,
    'aria-hidden="true" focusable="false"',
  )
  .replace(/<title[^>]*>.*?<\/title>/g, "")
  .replace(/<desc[^>]*>.*?<\/desc>/g, "");
---

<span
  class:list={["logo", className]}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={raw}
/>
