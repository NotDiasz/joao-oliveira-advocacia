---
import Logo from "./Logo.astro";
import Arrow from "./Arrow.astro";
import { site, whatsappUrl } from "../data/site";
---

<a href="#conteudo" class="skip-link">
  Pular para o conteúdo
</a>
<header class="site-header">
  <a class="home-link" href="/" aria-label="João Oliveira Advocacia — início">
    <Logo />
    <span>
      JOÃO OLIVEIRA <small>ADVOCACIA</small>
    </span>
  </a>
  <nav class="desktop-nav" aria-label="Navegação principal">
    <a href="/#atuacao">Atuação</a>
    <a href="/#sobre">O advogado</a>
    <a href="/#atendimento">Atendimento</a>
    <a class="nav-contact" href={whatsappUrl}>
      Vamos conversar <Arrow diagonal />
    </a>
  </nav>
  <button
    class="menu-toggle"
    aria-label="Abrir menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span></span>
    <span></span>
  </button>
  <nav
    id="mobile-menu"
    class="mobile-menu"
    aria-label="Navegação do celular"
    inert
  >
    <a href="/#atuacao">Atuação</a>
    <a href="/#sobre">O advogado</a>
    <a href="/#atendimento">Atendimento</a>
    <a href="/#contato">Contato</a>
    <span>
      {site.city} · {site.state}
    </span>
  </nav>
</header>
<aside class="social-rail" aria-label="Redes sociais">
  <a
    href={site.instagramUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Instagram de João Oliveira"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <rect
        x="3"
        y="3"
        width="18"
        height="18"
        rx="5"
        stroke="currentColor"
        stroke-width="1.2"
      />
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.2" />
      <circle cx="17.5" cy="6.5" r=".8" fill="currentColor" />
    </svg>
  </a>
  <span>CURITIBA, PR</span>
</aside>
