---
const { diagonal = false } = Astro.props;
---

<svg
  class="arrow-icon"
  width="22"
  height="22"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  <g transform={diagonal ? "rotate(-45 12 12)" : undefined}>
    <path
      d="M4 12h15m-6-6 6 6-6 6"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </g>
</svg>
